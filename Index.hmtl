// ═══════════════════ RENDER FUNCTIONS ═══════════════════
function calcScore(erp){
  const w={contabilidad:1.2,finanzas:1.1,compras:1,almacen:1,despacho:1,inventario:1.1,reportes:1.2,sii:1.3,implementacion:.8,precio:.9,soporte:1,escalabilidad:.8};
  let s=0,tot=0;
  Object.entries(w).forEach(([k,wt])=>{if(erp.scores[k]!==undefined){s+=erp.scores[k]*wt;tot+=10*wt;}});
  return Math.round(s/tot*10*10)/10;
}

function renderERP(erp){
  const score=calcScore(erp);
  const color=erp.tier==='tier-1'?'var(--accent)':erp.tier==='tier-2'?'var(--accent2)':'var(--accent3)';
  const scoreKeys=['contabilidad','finanzas','compras','almacen','despacho','inventario'];
  return `<div class="erp-card ${erp.tier}" onclick="showSection('comparison')">
    <div class="card-top">
      <div><div class="card-name">${erp.name}</div><div class="card-vendor">${erp.vendor}</div></div>
      <span class="tier-badge t${erp.tier.slice(-1)}">${erp.tierLabel}</span>
    </div>
    <div class="score-row"><span class="score-big" style="color:${color}">${score}</span><span class="score-max">/10</span></div>
    <div class="score-bars">
      ${scoreKeys.map(k=>`<div class="sbar-row">
        <span class="sbar-lbl">${k.charAt(0).toUpperCase()+k.slice(0,6)}</span>
        <div class="sbar-track"><div class="sbar-fill" style="width:${erp.scores[k]*10}%;background:${color}88"></div></div>
        <span class="sbar-val">${erp.scores[k]}</span>
      </div>`).join('')}
    </div>
    <div class="card-price"><b>${erp.price}</b></div>
    <div class="card-tags">${erp.tags.map(t=>`<span class="tag ${t==='SII'||t==='Hecho en Chile'||t==='Chile'?'chile':''}">${t}</span>`).join('')}</div>
  </div>`;
}

function renderModulesTable(){
  const thead=`<thead><tr><th>Módulo</th><th>Categoría</th>${ERPS.map(e=>`<th>${e.name}</th>`).join('')}</tr></thead>`;
  const cvIcon=(v)=>{
    if(v==='f') return `<span class="dot-full">✓</span>`;
    if(v==='p') return `<span class="dot-part">◑</span>`;
    if(v==='n') return `<span class="dot-none">○</span>`;
    if(v==='e') return `<span class="dot-ext">+</span>`;
    return `<span class="dot-none">○</span>`;
  };
  const tbody=`<tbody>${MODULES.map(m=>`<tr><td>${m.mod}</td><td class="module-cat">${m.cat}</td>${ERPS.map(e=>`<td style="text-align:center">${cvIcon(COVERAGE[e.id]?.[m.key]||'n')}</td>`).join('')}</tr>`).join('')}</tbody>`;
  document.getElementById('modulesTable').innerHTML=thead+tbody;
}

function renderCharts(){
  // Radar — top 4
  const top4=['sap_b1','defontana','odoo','softland'];
  const labels=['Contabilidad','Finanzas','Compras','Almacén','Despacho','Inventario','Reportes','SII'];
  const colors=['rgba(200,75,47,.7)','rgba(47,107,200,.7)','rgba(42,157,92,.7)','rgba(212,134,10,.7)'];
  const radarCtx=document.getElementById('radarChart').getContext('2d');
  new Chart(radarCtx,{type:'radar',
    data:{labels,datasets:top4.map((id,i)=>{const e=ERPS.find(x=>x.id===id);return{label:e.name,data:labels.map(l=>e.scores[l.toLowerCase().replace('é','e').replace('ó','o').replace('á','a').split(' ')[0].slice(0,10)]||e.scores[Object.keys(e.scores)[i%6]]),backgroundColor:colors[i].replace('.7','.1'),borderColor:colors[i],pointBackgroundColor:colors[i],borderWidth:2,pointRadius:3};})},
    options:{responsive:true,maintainAspectRatio:false,scales:{r:{grid:{color:'#e0dbd2'},ticks:{backdropColor:'transparent',font:{size:9,family:'DM Mono'},color:'#7a7268'},pointLabels:{font:{size:9,family:'DM Mono'},color:'#1a1612'},min:0,max:10}},plugins:{legend:{labels:{font:{size:10,family:'DM Mono'},color:'#1a1612',boxWidth:10}}}}});

  // Bar scores
  const barCtx=document.getElementById('barChart').getContext('2d');
  const sorted=[...ERPS].sort((a,b)=>calcScore(b)-calcScore(a));
  new Chart(barCtx,{type:'bar',
    data:{labels:sorted.map(e=>e.name),datasets:[{label:'Score Total',data:sorted.map(e=>calcScore(e)),backgroundColor:sorted.map(e=>e.tier==='tier-1'?'rgba(200,75,47,.75)':e.tier==='tier-2'?'rgba(47,107,200,.75)':'rgba(42,157,92,.75)'),borderRadius:2,borderSkipped:false}]},
    options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',plugins:{legend:{display:false},tooltip:{callbacks:{label:i=>' Score: '+i.raw+'/10'}}},scales:{x:{grid:{color:'#e0dbd2'},ticks:{font:{size:9,family:'DM Mono'},color:'#7a7268'},min:0,max:10},y:{grid:{color:'transparent'},ticks:{font:{size:9,family:'DM Mono'},color:'#1a1612'}}}}});

  // TCO chart
  const tcoCtx=document.getElementById('tcoChart').getContext('2d');
  const tcoSorted=[...ERPS].sort((a,b)=>a.tco3y-b.tco3y);
  new Chart(tcoCtx,{type:'bar',
    data:{labels:tcoSorted.map(e=>e.name),datasets:[{label:'TCO 3 años (USD)',data:tcoSorted.map(e=>e.tco3y),backgroundColor:tcoSorted.map(e=>e.tier==='tier-1'?'rgba(200,75,47,.7)':e.tier==='tier-2'?'rgba(47,107,200,.7)':'rgba(42,157,92,.7)'),borderRadius:2,borderSkipped:false}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:i=>' USD '+i.raw.toLocaleString()}}},scales:{x:{grid:{color:'transparent'},ticks:{font:{size:9,family:'DM Mono'},color:'#1a1612'}},y:{grid:{color:'#e0dbd2'},ticks:{font:{size:9,family:'DM Mono'},color:'#7a7268'},callback:(v)=>'$'+v/1000+'K'}}}});
}

function renderSWOT(){
  const swotERPs=['sap_b1','defontana','odoo','softland'];
  const swot={
    sap_b1:{f:'Funcionalidad industrial completa, escalabilidad total',d:'Costo alto, implementación lenta, complejidad'},
    defontana:{f:'SII perfecto, implementación rápida, soporte chileno',d:'Limitado para operaciones muy complejas'},
    odoo:{f:'Flexible, WMS excelente, bajo costo base',d:'SII requiere partner, calidad variable por implementador'},
    softland:{f:'Robusto localmente, manufactura/distribución fuerte',d:'Interfaz antigua, menor comunidad'},
  };
  const colors={'sap_b1':'var(--accent)','defontana':'var(--accent2)','odoo':'var(--accent3)','softland':'var(--amber)'};
  document.getElementById('swotGrid').innerHTML=swotERPs.map(id=>{
    const e=ERPS.find(x=>x.id===id);
    return `<div style="border:1px solid var(--border);padding:18px">
      <div style="font-family:var(--display);font-size:.9rem;font-weight:800;margin-bottom:10px;color:${colors[id]}">${e.name}</div>
      <div style="font-size:.72rem;font-family:var(--mono);color:var(--soft);margin-bottom:4px">FORTALEZAS</div>
      <p style="font-size:.78rem;line-height:1.5;margin-bottom:10px">${swot[id].f}</p>
      <div style="font-size:.72rem;font-family:var(--mono);color:var(--soft);margin-bottom:4px">DEBILIDADES</div>
      <p style="font-size:.78rem;line-height:1.5;color:var(--soft)">${swot[id].d}</p>
    </div>`;
  }).join('');
}

function renderPricing(){
  const tiers=[
    {label:'Tier 3 — PyME Accesible', erps:['bind_erp'], featured:false},
    {label:'Tier 2 — Solución Balanceada', erps:['defontana','softland','odoo'], featured:true},
    {label:'Tier 1 — Enterprise', erps:['sap_b1','microsoft_bc','oracle_netsuite','epicor'], featured:false},
  ];
  document.getElementById('pricingGrid').innerHTML=tiers.map(t=>{
    const erpList=t.erps.map(id=>ERPS.find(e=>e.id===id));
    return `<div class="price-col ${t.featured?'featured':''}">
      <div class="price-name">${t.label}</div>
      <div class="price-range">${erpList[0].price.split(' ')[0]+' '+erpList[0].price.split(' ')[1]}<small>/mes</small></div>
      <div class="price-sub">Implementación: ${erpList[0].impl}</div>
      <ul class="price-list">${erpList.map(e=>`<li><b>${e.name}</b> — ${e.desc.slice(0,60)}…</li>`).join('')}</ul>
      <div class="price-detail">TCO estimado 3 años (20 usuarios):<br><b>USD ${Math.min(...erpList.map(e=>e.tco3y)).toLocaleString()} – ${Math.max(...erpList.map(e=>e.tco3y)).toLocaleString()}</b></div>
    </div>`;
  }).join('');
}

function renderChecklist(){
  document.getElementById('checklistGrid').innerHTML=CHECKLIST_DATA.map((g,gi)=>`
    <div class="check-group">
      <h4>${g.group}</h4>
      <div class="check-list">
        ${g.items.map((item,ii)=>`<div class="check-item">
          <input type="checkbox" id="c${gi}_${ii}" onchange="updateCheckProgress(${gi})">
          <label for="c${gi}_${ii}">${item}</label>
        </div>`).join('')}
      </div>
      <div class="check-progress"><div class="check-progress-fill" id="cp${gi}" style="width:0%"></div></div>
      <div class="check-count" id="cc${gi}">0 / ${g.items.length} completados</div>
    </div>`).join('');
}

function updateCheckProgress(gi){
  const items=CHECKLIST_DATA[gi].items.length;
  const checked=document.querySelectorAll(`#checklistGrid .check-group:nth-child(${gi+1}) input:checked`).length;
  document.getElementById('cp'+gi).style.width=(checked/items*100)+'%';
  document.getElementById('cc'+gi).textContent=checked+' / '+items+' completados';
}

// ═══════════════════ WIZARD ═══════════════════
let wizStep=0, wizAnswers={};
const WIZARD_TOTAL=6;

function selectOpt(step, opt){
  document.querySelectorAll(`#wstep-${step} .wizard-opt`).forEach(b=>b.classList.remove('selected'));
  event.currentTarget.classList.add('selected');
  wizAnswers[step]=opt;
}

function wizardNext(){
  const step=wizStep;
  if(step<WIZARD_TOTAL){
    if(!wizAnswers[step]){
      const opts=document.querySelectorAll(`#wstep-${step} .wizard-opt`);
      if(opts.length){opts[0].click();}
    }
    document.getElementById('wstep-'+step).classList.remove('active');
    wizStep++;
    if(wizStep>=WIZARD_TOTAL){
      document.getElementById('wstep-result').classList.add('active');
      document.getElementById('wizNext').textContent='↺ Reiniciar';
      document.getElementById('wizNext').onclick=resetWizard;
      document.getElementById('wizProgress').style.width='100%';
      document.getElementById('wizStepLabel').textContent='¡Resultado listo!';
      renderWizardResult();
    } else {
      document.getElementById('wstep-'+wizStep).classList.add('active');
      document.getElementById('wizProgress').style.width=(wizStep/WIZARD_TOTAL*100)+'%';
      document.getElementById('wizStepLabel').textContent=`Paso ${wizStep+1} de ${WIZARD_TOTAL}`;
      document.getElementById('wizBack').style.display='inline-block';
    }
  }
}

function wizardBack(){
  document.getElementById('wstep-'+wizStep).classList.remove('active');
  wizStep--;
  document.getElementById('wstep-'+wizStep).classList.add('active');
  document.getElementById('wizProgress').style.width=(wizStep/WIZARD_TOTAL*100)+'%';
  document.getElementById('wizStepLabel').textContent=`Paso ${wizStep+1} de ${WIZARD_TOTAL}`;
  if(wizStep===0) document.getElementById('wizBack').style.display='none';
}

function resetWizard(){
  document.getElementById('wstep-result').classList.remove('active');
  wizStep=0; wizAnswers={};
  document.getElementById('wstep-0').classList.add('active');
  document.querySelectorAll('.wizard-opt').forEach(b=>b.classList.remove('selected'));
  document.getElementById('wizProgress').style.width='0%';
  document.getElementById('wizStepLabel').textContent='Paso 1 de 6';
  document.getElementById('wizNext').textContent='Siguiente →';
  document.getElementById('wizNext').onclick=wizardNext;
  document.getElementById('wizBack').style.display='none';
}

function renderWizardResult(){
  // Scoring logic based on answers
  const scores={sap_b1:0,defontana:0,odoo:0,oracle_netsuite:0,microsoft_bc:0,softland:0,epicor:0,bind_erp:0};
  const a=wizAnswers;
  // Q0: users
  if(a[0]==='a'){scores.bind_erp+=3;scores.defontana+=2;scores.odoo+=1;}
  if(a[0]==='b'){scores.defontana+=3;scores.softland+=2;scores.odoo+=2;scores.microsoft_bc+=1;}
  if(a[0]==='c'){scores.sap_b1+=2;scores.odoo+=3;scores.microsoft_bc+=2;scores.softland+=2;}
  if(a[0]==='d'){scores.sap_b1+=4;scores.oracle_netsuite+=3;scores.epicor+=2;}
  // Q1: budget
  if(a[1]==='a'){scores.bind_erp+=4;scores.odoo+=2;}
  if(a[1]==='b'){scores.defontana+=3;scores.softland+=3;scores.odoo+=2;}
  if(a[1]==='c'){scores.sap_b1+=2;scores.microsoft_bc+=3;scores.odoo+=2;}
  if(a[1]==='d'){scores.sap_b1+=3;scores.oracle_netsuite+=3;scores.epicor+=3;}
  // Q2: inventory
  if(a[2]==='a'){scores.defontana+=2;scores.bind_erp+=2;}
  if(a[2]==='b'){scores.softland+=2;scores.odoo+=2;scores.defontana+=1;}
  if(a[2]==='c'){scores.odoo+=4;scores.epicor+=4;scores.sap_b1+=3;}
  // Q3: reporting
  if(a[3]==='a'){scores.defontana+=1;scores.bind_erp+=2;}
  if(a[3]==='b'){scores.defontana+=3;scores.softland+=3;scores.odoo+=2;}
  if(a[3]==='c'){scores.oracle_netsuite+=4;scores.sap_b1+=3;scores.microsoft_bc+=3;}
  // Q4: SII
  if(a[4]==='a'){scores.defontana+=2;scores.bind_erp+=2;scores.softland+=2;}
  if(a[4]==='b'){scores.defontana+=4;scores.softland+=4;}
  if(a[4]==='c'){scores.defontana+=3;scores.softland+=3;}
  // Q5: timeline
  if(a[5]==='a'){scores.bind_erp+=4;scores.defontana+=3;}
  if(a[5]==='b'){scores.defontana+=2;scores.softland+=2;scores.odoo+=2;scores.microsoft_bc+=1;}
  if(a[5]==='c'){scores.sap_b1+=3;scores.oracle_netsuite+=2;scores.epicor+=2;}

  const sorted=Object.entries(scores).sort((a,b)=>b[1]-a[1]).slice(0,3);
  const winner=ERPS.find(e=>e.id===sorted[0][0]);
  const second=ERPS.find(e=>e.id===sorted[1][0]);
  const third=ERPS.find(e=>e.id===sorted[2][0]);

  document.getElementById('wizardResult').innerHTML=`
    <div style="font-family:var(--mono);font-size:.7rem;color:var(--soft);text-transform:uppercase;letter-spacing:.1em">Nuestra recomendación</div>
    <div class="result-winner">${winner.name}</div>
    <p class="result-sub">${winner.desc}</p>
    <div class="result-scores">
      <div class="rs"><div class="rs-name">${winner.name}</div><div class="rs-score">${sorted[0][1]} pts</div><div class="rs-rank">🥇 Recomendado</div></div>
      <div class="rs"><div class="rs-name">${second.name}</div><div class="rs-score">${sorted[1][1]} pts</div><div class="rs-rank">🥈 Alternativa</div></div>
      <div class="rs"><div class="rs-name">${third.name}</div><div class="rs-score">${sorted[2][1]} pts</div><div class="rs-rank">🥉 Considerar</div></div>
    </div>
    <div style="text-align:left;margin-top:16px">
      <div style="font-family:var(--mono);font-size:.7rem;color:var(--soft);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px">Por qué ${winner.name} para tu empresa:</div>
      ${winner.pros.map(p=>`<div style="display:flex;gap:8px;font-size:.8rem;margin-bottom:6px;align-items:flex-start"><span style="color:var(--accent3);font-weight:700;flex-shrink:0">✓</span>${p}</div>`).join('')}
      <div style="font-family:var(--mono);font-size:.7rem;color:var(--soft);text-transform:uppercase;letter-spacing:.08em;margin:14px 0 10px">Puntos a validar:</div>
      ${winner.cons.map(c=>`<div style="display:flex;gap:8px;font-size:.8rem;margin-bottom:6px;align-items:flex-start;color:var(--soft)"><span style="color:var(--amber);font-weight:700;flex-shrink:0">!</span>${c}</div>`).join('')}
      <div style="margin-top:20px;padding:14px;background:var(--light);font-family:var(--mono);font-size:.72rem;color:var(--soft)">
        💰 Precio estimado: <b style="color:var(--ink)">${winner.price}</b> · Implementación: <b style="color:var(--ink)">${winner.impl}</b>
      </div>
    </div>`;
}

// ═══════════════════ NAV ═══════════════════
function showSection(id){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const tabs={overview:0,modules:1,comparison:2,pricing:3,wizard:4,checklist:5};
  document.querySelectorAll('.nav-tab')[tabs[id]].classList.add('active');
}

// ═══════════════════ INIT ═══════════════════
document.getElementById('erpCards').innerHTML=ERPS.map(renderERP).join('');
renderModulesTable();
renderCharts();
renderSWOT();
renderPricing();
renderChecklist();
</script>
</body>
</html>
"subida inicial"
